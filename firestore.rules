rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 管理者（スタッフまたはスーパー管理者）かどうかを判定
    function isStaff() {
      return request.auth != null && 
        (request.auth.token.email == "staff@example.com" || request.auth.token.email == "super@example.com");
    }

    // 予約履歴コレクション（誰でも予約はできるが、削除や完了はスタッフのみ）
    match /reserveHistory/{document} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isStaff(); 
    }

    // ランキングコレクション（誰でも見れるが、登録・編集・削除はスタッフのみ）
    match /rankings/{document} {
      allow read: if true;
      allow write, delete: if isStaff();
    }

    // 整理番号カウンター（誰でも進められるが、削除は絶対禁止）
    match /reserves/global {
      allow read, update: if true;
      allow delete: if false; 
    }

    // 来場者数カウンター（誰でも進められるが、削除は絶対禁止）
    match /visitors/total {
      allow read, update: if true;
      allow delete: if false;
    }

    // rolesコレクション（スタッフの権限確認用）
    match /roles/{document} {
      allow read: if isStaff();
      allow write: if false;
    }
  }
}
