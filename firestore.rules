rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ランキング: 誰でも読める、書き込みは認証不要（文化祭限定のためオープン）
    match /rankings/{doc} {
      allow read: if true;
      allow write: if true;
    }

    // 整理番号カウンター
    match /reserves/{doc} {
      allow read, write: if true;
    }

    // 整理番号履歴
    match /reserveHistory/{doc} {
      allow read, write: if true;
    }

    // 待ち時間
    match /waitTimes/{doc} {
      allow read, write: if true;
    }

    // 来場者数
    match /visitors/{doc} {
      allow read, write: if true;
    }
  }
}
