// Firebase Security Rules の設定例
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 管理者（スタッフ）かどうかを判定する関数
    function isStaff() {
      return request.auth != null && 
        (request.auth.token.email == 'staff@example.com' || request.auth.token.email == 'super@example.com');
    }

    match /reserveHistory/{doc} {
      // 誰でも作成（予約）はできるが、削除や変更はスタッフのみ
      allow create: if true; 
      allow update, delete: if isStaff(); 
      allow read: if true; // ※優先度3で後述しますが、理想はreadも制限すべきです
    }

    match /rankings/{doc} {
      allow read: if true;
      allow write, delete: if isStaff(); // スコア登録・削除はスタッフのみ
    }
    
    // globalカウンターなども勝手に書き換えられないよう保護
    match /reserves/global {
      allow read, update: if true;
      allow delete: if false;
    }
  }
}
