rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 管理者（スタッフまたはスーパー管理者）かどうかを判定
    function isStaff() {
      return request.auth != null &&
        get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role in ['staff', 'super'];
    }

    // 予約履歴（誰でも読み書き可、削除・更新はスタッフのみ）
    match /reserveHistory/{document} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isStaff();
    }

    // ランキング（誰でも読める、書き込みはスタッフのみ）
    match /rankings/{document} {
      allow read: if true;
      allow write, delete: if isStaff();
    }

    // 整理番号カウンター（誰でも読み・更新可、削除禁止）
    match /reserves/global {
      allow read, update: if true;
      allow delete: if false;
    }

    // 来場者数カウンター（誰でも読み・更新可、削除禁止）
    match /visitors/total {
      allow read, update: if true;
      allow delete: if false;
    }

    // rolesコレクション（自分のドキュメントのみ読める、書き込み禁止）
    match /roles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // 待ち時間（誰でも読める、書き込みはスタッフのみ）
    match /waitTimes/{document} {
      allow read: if true;
      allow write: if isStaff();
    }

    // サイトログ（読みはスタッフのみ、作成は認証済みユーザー）
    match /siteLogs/{document} {
      allow read: if isStaff();
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
