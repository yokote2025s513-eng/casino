rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 公開コレクション（誰でも読める） ──

    // ランキング（読みは誰でも、書き込みはログイン済みのみ）
    match /rankings/{doc} {
      allow read: if true;
      allow write, delete: if request.auth != null;
    }

    // 待ち時間（読みは誰でも、書き込みはログイン済みのみ）
    match /waitTimes/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 来場者数（読みは誰でも、更新はログイン済みのみ、削除禁止）
    match /visitors/total {
      allow read: if true;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // 整理番号カウンター（読み・更新は誰でも、削除禁止）
    match /reserves/global {
      allow read, update: if true;
      allow delete: if false;
    }

    // 予約履歴（読み・作成は誰でも、削除はログイン済みのみ）
    match /reserveHistory/{doc} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    // ── スタッフ限定コレクション ──

    // rolesコレクション（ログイン済みなら自分のドキュメントだけ読める、書き込み禁止）
    match /roles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // サイトログ（作成はログイン済みのみ、読み・削除は禁止）
    match /siteLogs/{doc} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
  }
}
